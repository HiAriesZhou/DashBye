{
  "name": "dashbye",
  "version": "0.7.0",
  "description": "Local-first CLI for versioning and synchronizing browser extension store releases: Chrome Web Store, with optional Firefox Add-ons and Edge Add-ons.",
  "author": "AriesZhou <urchinzhou@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HiAriesZhou/DashBye.git"
  },
  "homepage": "https://dashbye.lol",
  "bugs": {
    "url": "https://github.com/HiAriesZhou/DashBye/issues"
  },
  "keywords": [
    "browser-extension",
    "chrome-extension",
    "chrome-web-store",
    "firefox-addons",
    "edge-addons",
    "cli",
    "coding-agent",
    "release-automation"
  ],
  "type": "module",
  "bin": {
    "dashbye": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "docs/store-schema.md",
    "examples",
    "README.md",
    "README.zh-CN.md",
    "LICENSING.md",
    "TRADEMARK.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/mark-bin.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm test",
    "test": "npm run build && node --test dist/tests/*.test.js && node scripts/check-release-boundary.mjs",
    "start": "node dist/src/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "playwright-core": "^1.62.1",
    "sharp": "^0.35.4",
    "undici": "^7.30.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "typescript": "^5.9.2"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
