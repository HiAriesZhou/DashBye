---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { copy, paths, type Lang } from '../lib/copy';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy[lang];
const file = lang === 'en' ? 'usage.md' : 'usage.zh-CN.md';
const entry = (await getCollection('guides')).find(guide => guide.filePath?.endsWith(`/${file}`));
if (!entry) throw new Error(`docs/${file} is missing from the guides collection`);
const { Content, headings } = await render(entry);
const sections = headings.filter(heading => heading.depth === 2);
const other = lang === 'en' ? paths.zh.docs : paths.en.docs;
---
<Base lang={lang} title={t.meta.docsTitle} description={t.meta.docsDescription} alternate={other}>
  <div class="wrap guide">
    <nav class="toc" aria-labelledby="toc-title">
      <p id="toc-title">{t.docs.onPage}</p>
      <ol>{sections.map(section => <li><a href={`#${section.slug}`}>{section.text}</a></li>)}</ol>
    </nav>
    <article class="prose">
      <Content />
      <p class="top"><a href="#main">{t.docs.back} <span aria-hidden="true">↑</span></a></p>
    </article>
  </div>
</Base>

<style>
  .guide { display: grid; gap: 32px; padding-top: 24px; padding-bottom: var(--section); }
  .toc p { margin: 0 0 8px; font: 600 13px var(--font-display); color: var(--ink-faint); }
  .toc ol { margin: 0; padding: 0; list-style: none; columns: 2 160px; column-gap: 24px; }
  .toc a {
    display: block;
    padding: 5px 0 5px 12px;
    border-left: 1px solid var(--rule);
    color: var(--ink-soft);
    font-size: 14px;
    line-height: 1.4;
    text-decoration: none;
    break-inside: avoid;
  }
  @media (hover: hover) {
    .toc a:hover { color: var(--ink); border-left-color: var(--green); }
  }
  @media (min-width: 1000px) {
    .guide { grid-template-columns: 220px minmax(0, 1fr); gap: 64px; }
    .toc { position: sticky; top: 24px; align-self: start; max-height: calc(100vh - 48px); overflow-y: auto; }
    .toc ol { columns: auto; }
  }

  .prose { min-width: 0; max-width: 74ch; }
  .prose :global(h1) { font-size: clamp(34px, 5vw, 48px); font-weight: 700; }
  .prose :global(h1 + p) { color: var(--ink-faint); font-size: 15px; }
  .prose :global(h2) { margin-top: 64px; padding-top: 20px; border-top: 1px solid var(--rule); font-size: clamp(24px, 3vw, 30px); }
  .prose :global(h3) { margin-top: 36px; font-size: 20px; }
  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin: 16px 0 0; }
  .prose :global(li + li) { margin-top: 6px; }
  .prose :global(a) { color: var(--green-ink); }
  .prose :global(:not(pre) > code) {
    padding: 1px 5px;
    border-radius: 4px;
    background: var(--paper-step);
    overflow-wrap: anywhere;
  }
  .prose :global(pre) {
    margin: 20px 0 0;
    padding: 16px 18px;
    border-radius: var(--radius-m);
    background: var(--paper-step) !important;
    box-shadow: inset 0 0 0 1px var(--rule);
    overflow-x: auto;
    font-size: 13.5px;
    line-height: 1.65;
  }
  .prose :global(pre code) { font-size: inherit; }
  .prose :global(blockquote) {
    margin: 20px 0 0;
    padding: 4px 16px 14px;
    border-radius: var(--radius-m);
    background: color-mix(in srgb, var(--amber) 9%, transparent);
  }
  .prose :global(table) { width: 100%; margin-top: 20px; border-collapse: collapse; font-size: 15px; display: block; overflow-x: auto; }
  .prose :global(th), .prose :global(td) { padding: 10px 14px 10px 0; text-align: left; vertical-align: top; border-bottom: 1px solid var(--rule); }
  .prose :global(th) { font: 600 13px var(--font-display); color: var(--ink-faint); border-bottom-color: var(--ink); }
  .prose :global(img) { border-radius: var(--radius-m); }
  .top { margin-top: 56px !important; }
  .top a { font-weight: 600; text-decoration: none; }

  @media (prefers-color-scheme: dark) {
    .prose :global(.astro-code), .prose :global(.astro-code span) {
      color: var(--shiki-dark) !important;
      font-style: var(--shiki-dark-font-style) !important;
    }
  }
</style>
