---
// Octicons (MIT) for interface glyphs, Simple Icons (CC0) for npm and Node.js marks.
// Both render at build time as inline SVG in currentColor; nothing loads in the browser.
import octicons from '@primer/octicons';
import { siNodedotjs, siNpm } from 'simple-icons';

const OCTICONS = { github: 'mark-github', book: 'book', star: 'star-fill', law: 'law', shield: 'shield-check' } as const;
const BRANDS = { npm: siNpm, node: siNodedotjs } as const;

type Name = keyof typeof OCTICONS | keyof typeof BRANDS;
interface Props { name: Name; size?: number; class?: string }
const { name, size = 16, class: className } = Astro.props;

const brand = name in BRANDS ? BRANDS[name as keyof typeof BRANDS] : null;
const octicon = brand ? null : octicons[OCTICONS[name as keyof typeof OCTICONS]].heights[16];
const viewBox = brand ? '0 0 24 24' : `0 0 ${octicon!.width} 16`;
const body = brand ? `<path d="${brand.path}"></path>` : octicon!.path;
---
<svg class={className} viewBox={viewBox} width={size} height={size} fill="currentColor" aria-hidden="true" focusable="false" set:html={body} />
