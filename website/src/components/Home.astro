---
import { Image } from 'astro:assets';
import CopyButton from './CopyButton.astro';
import StarPrompt from './StarPrompt.astro';
import Terminal from './Terminal.astro';
import mascot from '../../../brand/dashbye-readme.png';
import { copy, paths, type Lang } from '../lib/copy';
import { agentPrompt, links, version } from '../lib/repo';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy[lang];
const install = 'npm install --global dashbye';
---
<section class="wrap hero">
  <div class="hero-text">
    <h1>{t.hero.title.map(line => <span>{line}</span>)}</h1>
    <p class="lede">{t.hero.lede}</p>
    <div class="install">
      <code><span aria-hidden="true">$ </span>{install}</code>
      <CopyButton lang={lang} text={install} />
    </div>
    <p class="prompt-line"><StarPrompt lang={lang} /></p>
    <p class="hero-links">
      <a href={paths[lang].docs}>{t.hero.guide} <span aria-hidden="true">→</span></a>
    </p>
    <ul class="facts">
      <li><a href={links.npm}>v{version}</a></li>
      {t.hero.facts.map(fact => <li>{fact}</li>)}
    </ul>
  </div>
  <Image class="mascot" src={mascot} alt={t.hero.mascotAlt} width={440} widths={[280, 440, 880]} sizes="(min-width: 900px) 440px, 280px" loading="eager" fetchpriority="high" />
</section>

<section class="wrap release" aria-labelledby="release-title">
  <p class="eyebrow"><code>{t.release.eyebrow}</code></p>
  <h2 id="release-title">{t.release.title}</h2>
  <div class="release-grid">
    <Terminal />
    <ol class="notes">
      {t.release.notes.map(note => (
        <li><strong>{note.term}</strong><span>{note.text}</span></li>
      ))}
    </ol>
  </div>
</section>

<section class="wrap problems" aria-labelledby="problems-title">
  <h2 id="problems-title">{t.problems.title}</h2>
  <dl>
    {t.problems.items.map(item => (
      <div><dt>{item.q}</dt><dd>{item.a}</dd></div>
    ))}
  </dl>
</section>

<section class="wrap flow" aria-labelledby="flow-title">
  <h2 id="flow-title">{t.flow.title}</h2>
  <ol class="steps">
    {t.flow.steps.map((step, index) => (
      <li class:list={{ you: index === 3 }}>
        <span class="num">{String(index + 1).padStart(2, '0')}</span>
        <span class="who">{step.who}</span>
        <p>{step.text}</p>
      </li>
    ))}
  </ol>
  <p class="aside">{t.flow.local}</p>
</section>

<section class="wrap stores" aria-labelledby="stores-title">
  <h2 id="stores-title">{t.stores.title}</h2>
  <table role="table">
    <thead role="rowgroup"><tr role="row">{t.stores.head.map(cell => <th scope="col" role="columnheader">{cell}</th>)}</tr></thead>
    <tbody role="rowgroup">
      {t.stores.rows.map(([store, does, you]) => (
        <tr role="row">
          <th scope="row" role="rowheader">{store}</th>
          <td role="cell" data-label={t.stores.head[1]}>{does}</td>
          <td role="cell" data-label={t.stores.head[2]}>{you}</td>
        </tr>
      ))}
    </tbody>
  </table>
  <p class="caution">{t.stores.firefox}</p>
</section>

<section class="wrap agent" aria-labelledby="agent-title">
  <div class="agent-head">
    <h2 id="agent-title">{t.agent.title}</h2>
    <p>{t.agent.intro}</p>
  </div>
  <div class="prompt">
    <div class="prompt-bar"><CopyButton lang={lang} text={agentPrompt[lang]} tone="dark" /></div>
    <pre><code>{agentPrompt[lang]}</code></pre>
  </div>
  <div class="split">
    <div><h3>{t.agent.agentHead}</h3><ul>{t.agent.agentDoes.map(item => <li>{item}</li>)}</ul></div>
    <div><h3>{t.agent.youHead}</h3><ul>{t.agent.youDo.map(item => <li>{item}</li>)}</ul></div>
  </div>
</section>

<section class="wrap limits">
  <div>
    <h2>{t.never.title}</h2>
    <ul class="never">{t.never.items.map(item => <li>{item}</li>)}</ul>
    <a href={links.security}>{t.never.more} <span aria-hidden="true">→</span></a>
  </div>
  <div class="status">
    <h2>{t.status.title}</h2>
    <p>{t.status.text}</p>
    <a href={links.validation}>{t.status.link} <span aria-hidden="true">→</span></a>
  </div>
</section>

<section class="wrap end" aria-labelledby="end-title">
  <h2 id="end-title">{t.end.title}</h2>
  <div class="install">
    <code><span aria-hidden="true">$ </span>{install}</code>
    <CopyButton lang={lang} text={install} />
  </div>
  <p class="prompt-line"><StarPrompt lang={lang} /></p>
  <p class="hero-links">
    <a href={paths[lang].docs}>{t.end.guide} <span aria-hidden="true">→</span></a>
  </p>
</section>

<style>
  section + section { margin-top: var(--section); }
  h2 { max-width: 24ch; text-wrap: balance; }
  .hero-text { min-width: 0; }

  /* Hero: text carries the page; the gecko waves from the dashboard it is leaving. */
  .hero {
    display: grid;
    gap: 24px;
    padding-top: clamp(24px, 6vw, 72px);
  }
  h1 {
    font-size: clamp(42px, 7vw, 72px);
    font-weight: 700;
    line-height: 1.02;
  }
  h1 span { display: block; }
  h1 span + span { color: var(--green-ink); }
  .lede {
    max-width: 60ch;
    margin: 24px 0 0;
    color: var(--ink-soft);
    font-size: clamp(17px, 1.6vw, 19px);
  }
  .install {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    max-width: 100%;
    margin-top: 32px;
    padding: 6px 6px 6px 16px;
    border-radius: var(--radius-m);
    background: var(--paper-step);
    box-shadow: inset 0 0 0 1px var(--rule);
  }
  .install code {
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
    font-size: 15px;
  }
  .install code span { color: var(--ink-faint); }
  /* The question continues the install box like the next terminal line, aligned with its "$". */
  .prompt-line { margin: 6px 0 0; padding-left: 17px; }
  .hero-links { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin: 12px 0 0; }
  .hero-links a, .limits a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    font-weight: 600;
    color: var(--green-ink);
    text-decoration: none;
  }
  @media (hover: hover) {
    .hero-links a:hover, .limits a:hover { text-decoration: underline; }
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
    color: var(--ink-faint);
    font-size: 14px;
  }
  .facts a { font-family: var(--font-mono); color: inherit; }
  /* Phones: the gecko waves from above the headline instead of trailing the facts. */
  .mascot { order: -1; width: 128px; margin-bottom: -8px; }
  @media (max-width: 419px) {
    .install code { font-size: 14px; }
  }
  @media (min-width: 900px) {
    .hero { grid-template-columns: 1fr 400px; align-items: center; gap: 48px; }
    .mascot { order: 0; width: 400px; margin-bottom: 8px; }
  }

  .eyebrow { margin: 0 0 12px; color: var(--green-ink); font-size: 15px; }
  .release-grid { display: grid; gap: 28px; margin-top: 32px; }
  .notes { display: grid; gap: 20px; margin: 0; padding: 0; list-style: none; counter-reset: note; }
  .notes li { display: grid; grid-template-columns: 22px 1fr; column-gap: 12px; counter-increment: note; }
  .notes li::before {
    content: counter(note);
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    margin-top: 2px;
    border-radius: 50%;
    background: var(--green-wash);
    color: var(--green-ink);
    font: 700 12px/1 var(--font-display);
  }
  .notes strong { font-family: var(--font-display); font-weight: 600; }
  .notes span { color: var(--ink-soft); font-size: 15px; }
  @media (min-width: 1000px) {
    .release-grid { grid-template-columns: minmax(0, 1fr) 300px; align-items: start; gap: 40px; }
  }

  .problems dl { display: grid; gap: 0; margin: 32px 0 0; }
  .problems dl > div { padding: 20px 0; border-top: 1px solid var(--rule); }
  .problems dt { font: 600 19px/1.35 var(--font-display); }
  .problems dd { margin: 8px 0 0; color: var(--ink-soft); max-width: 46ch; }
  @media (min-width: 900px) {
    .problems dl { grid-template-columns: repeat(3, 1fr); gap: 40px; }
    .problems dl > div { padding-top: 24px; }
  }

  .steps { display: grid; gap: 0; margin: 32px 0 0; padding: 0; list-style: none; }
  .steps li {
    display: grid;
    grid-template-columns: 36px auto;
    column-gap: 12px;
    padding: 16px 0;
    border-top: 1px solid var(--rule);
  }
  .num { grid-row: span 2; font: 500 13px/1.9 var(--font-mono); color: var(--ink-faint); }
  .who {
    justify-self: start;
    padding: 2px 8px;
    border-radius: var(--radius-s);
    background: var(--paper-step);
    font: 600 13px/1.6 var(--font-display);
  }
  .steps p { margin: 8px 0 0; color: var(--ink-soft); font-size: 15px; }
  .steps .you { border-top-color: var(--green); }
  .steps .you .who { background: var(--green-ink); color: var(--paper); }
  .aside { max-width: 70ch; margin: 28px 0 0; color: var(--ink-soft); font-size: 15px; }
  @media (min-width: 900px) {
    .steps { grid-template-columns: repeat(5, 1fr); gap: 24px; }
    .steps li { grid-template-columns: 1fr; border-top-width: 2px; }
    .num { grid-row: auto; margin-bottom: 8px; }
  }

  table { width: 100%; margin-top: 32px; border-collapse: collapse; font-size: 15px; }
  thead th {
    padding: 0 16px 12px 0;
    text-align: left;
    font: 600 13px var(--font-display);
    color: var(--ink-faint);
    border-bottom: 1px solid var(--ink);
  }
  tbody th, tbody td { padding: 18px 16px 18px 0; text-align: left; vertical-align: top; border-bottom: 1px solid var(--rule); }
  tbody th { width: 22%; font: 600 16px/1.4 var(--font-display); }
  tbody td { color: var(--ink-soft); }
  tbody td:nth-child(2) { width: 46%; }
  @media (max-width: 719px) {
    thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    table, tbody, tr, th, td { display: block; width: auto !important; }
    tbody tr { padding: 18px 0; border-bottom: 1px solid var(--rule); }
    tbody th, tbody td { padding: 0; border: 0; }
    tbody td { margin-top: 10px; }
    tbody td::before {
      content: attr(data-label);
      display: block;
      font: 600 12px/1.6 var(--font-display);
      color: var(--ink-faint);
    }
  }
  .caution {
    max-width: 75ch;
    margin: 24px 0 0;
    padding: 14px 16px;
    border-radius: var(--radius-m);
    background: color-mix(in srgb, var(--amber) 10%, transparent);
    font-size: 15px;
  }

  .agent-head p { max-width: 60ch; margin: 16px 0 0; color: var(--ink-soft); }
  .prompt {
    position: relative;
    margin-top: 28px;
    border-radius: var(--radius-m);
    background: var(--term-bg);
    color: var(--term-ink);
  }
  .prompt-bar { position: absolute; top: 10px; right: 10px; }
  .prompt pre {
    margin: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    padding: 20px;
    padding-top: 60px;
    overflow-x: auto;
    font-size: 13.5px;
    line-height: 1.7;
  }
  .prompt code { font-size: inherit; }
  .split { display: grid; gap: 24px; margin-top: 28px; }
  .split h3 { font-size: 17px; }
  .split ul { margin: 10px 0 0; padding-left: 1.1em; color: var(--ink-soft); font-size: 15px; }
  .split li + li { margin-top: 6px; }
  @media (min-width: 720px) {
    .split { grid-template-columns: 1fr 1fr; gap: 40px; }
    .prompt pre { padding: 24px 28px; padding-right: 110px; }
  }

  .limits { display: grid; gap: 56px; }
  .limits h2 { font-size: clamp(24px, 2.8vw, 30px); }
  .never { margin: 20px 0 12px; padding: 0; list-style: none; }
  .never li { position: relative; padding: 12px 0 12px 28px; border-bottom: 1px solid var(--rule); }
  .never li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 50%;
    width: 12px;
    height: 2px;
    background: var(--ink-faint);
  }
  .status p { max-width: 52ch; margin: 20px 0 12px; color: var(--ink-soft); }
  @media (min-width: 900px) {
    .limits { grid-template-columns: 1.2fr 1fr; gap: 72px; }
  }

  .end { padding-bottom: var(--section); }
  .end h2 { max-width: 18ch; font-size: clamp(30px, 4.4vw, 48px); }
</style>
