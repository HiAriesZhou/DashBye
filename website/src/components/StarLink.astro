---
import Icon from './Icon.astro';
import { copy, type Lang } from '../lib/copy';
import { links, stars } from '../lib/repo';

interface Props { lang: Lang }
const t = copy[Astro.props.lang].star;
const label = stars === null ? t.label : `${t.label}, ${t.count(stars)}`;
---
<a class="star" href={links.github} aria-label={label}>
  <span class="ask"><Icon name="github" />{t.text}</span>
  <span class="count" aria-hidden="true"><Icon name="star" class="glyph" />{stars ?? '★'}</span>
</a>

<style>
  .star {
    display: inline-flex;
    align-items: stretch;
    min-height: 40px;
    border-radius: var(--radius-m);
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--rule), 0 1px 2px rgba(29, 48, 67, 0.06);
    color: var(--ink);
    font: 600 14px/1 var(--font-display);
    text-decoration: none;
    transition-property: transform, box-shadow;
    transition-duration: 140ms;
    transition-timing-function: var(--ease-out);
  }
  .star:active { transform: scale(0.96); }
  .ask, .count { display: inline-flex; align-items: center; gap: 8px; padding: 0 12px; }
  .count {
    gap: 6px;
    border-left: 1px solid var(--rule);
    font: 500 13px/1 var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--ink-soft);
  }
  .star :global(.glyph) {
    color: var(--green);
    transition-property: transform;
    transition-duration: 200ms;
    transition-timing-function: var(--ease-out);
  }
  @media (hover: hover) {
    .star:hover { box-shadow: inset 0 0 0 1px var(--green), 0 1px 2px rgba(29, 48, 67, 0.06); }
    .star:hover :global(.glyph) { transform: scale(1.2); }
  }
</style>
