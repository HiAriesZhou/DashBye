---
import Icon from './Icon.astro';
import { copy, paths, type Lang } from '../lib/copy';
import { links } from '../lib/repo';

interface Props { lang: Lang; alternate: string }
const { lang, alternate } = Astro.props;
const t = copy[lang];
const other = lang === 'en' ? 'zh-CN' : 'en';
---
<header class="wrap bar">
  <a class="mark" href={paths[lang].home} aria-label={t.nav.home}>
    <span>Dash</span><span class="bye">Bye</span>
  </a>
  <nav aria-label={t.nav.label}>
    <a class="icon" href={paths[lang].docs} aria-label={t.nav.guide} title={t.nav.guide}><Icon name="book" size={18} /></a>
    <a class="icon" href={links.github} aria-label={t.nav.github} title={t.nav.github}><Icon name="github" size={18} /></a>
    <a class="lang" href={alternate} hreflang={other} lang={other} title={t.nav.switchName}>{t.nav.switchLabel}</a>
  </nav>
</header>

<style>
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 20px;
    padding-bottom: 20px;
  }
  .mark {
    font: 700 22px/1 var(--font-display);
    letter-spacing: -0.03em;
    text-decoration: none;
    padding: 8px 0;
  }
  .bye { color: var(--green); }
  nav { display: flex; gap: 4px; }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 10px;
    border-radius: var(--radius-s);
    color: var(--ink-soft);
    font-size: 15px;
    text-decoration: none;
    transition-property: transform, background-color, color;
    transition-duration: 140ms;
    transition-timing-function: var(--ease-out);
  }
  nav a.icon { justify-content: center; width: 40px; padding: 0; }
  nav a.lang { margin-left: 4px; font-family: var(--font-display); font-weight: 600; color: var(--ink); }
  nav a:active { transform: scale(0.96); }
  @media (hover: hover) {
    nav a:hover { color: var(--ink); background: var(--paper-step); }
  }
</style>
